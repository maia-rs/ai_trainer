# ==============================
# AITrainer - Environment Sample
# ==============================
# Copy this file to .env in your VPS and fill the values.
# Example:
#   cp .env.example .env

# Public base URL of your API
BASE_URL=https://api.seu-dominio.com
ENVIRONMENT=production

# ------------------------------
# Database configuration
# ------------------------------
# Option A: full connection URL (recommended in production)
# DB_URL=mysql+mysqlconnector://usuario:senha@host:3306/ai_trainer

# Option B: split variables (used when DB_URL is not set)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ai_trainer
DB_USER=ai_trainer_user
DB_PASSWORD=troque-por-uma-senha-forte

# MySQL container variables (used by docker-compose mysql service)
MYSQL_DATABASE=ai_trainer
MYSQL_USER=ai_trainer_user
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-forte

# ------------------------------
# LLM providers
# ------------------------------
# Generic key used as fallback for GROQ_API_KEY in app/core/config.py
API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini
API_KEY_GEMINI=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------
# LangSmith tracing (optional)
# ------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AITrainer-Agent
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------
# Evolution API (WhatsApp)
# ------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=aitrainer
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_DEDUP_TTL_SECONDS=600

# ------------------------------
# Gunicorn runtime (Docker)
# ------------------------------
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
