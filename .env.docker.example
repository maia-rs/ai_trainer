# API
BASE_URL=https://seu-dominio.com
ENVIRONMENT=production

# Banco de dados
DB_HOST=host-do-banco
DB_PORT=3306
DB_NAME=ai_trainer
DB_USER=usuario
DB_PASSWORD=senha-forte
# Alternativa: usar URL completa no lugar das variaveis acima
# DB_URL=mysql+mysqlconnector://usuario:senha@host:3306/ai_trainer

# LLMs
API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
API_KEY_GEMINI=
GEMINI_MODEL=gemini-1.5-flash

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AITrainer-Agent
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=aitrainer
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_DEDUP_TTL_SECONDS=600

# Gunicorn tuning
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
